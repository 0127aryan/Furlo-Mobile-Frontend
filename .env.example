# AdMob. Leave blank in local dev to use Google's test app ids.
# Production EAS builds need the real ids or the banner stays hidden.
# App id from AdMob → Apps (ca-app-pub-...~...)
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
# Banner ad unit id (ca-app-pub-.../...)
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=
